# #Create correlation matrix with pairwise correlation using Kendall's tau. This method is slightly better for <LOQ than Spearman, as Kendall compares two observations, not the whole dataset at the time.
kendall_matrix_Boelstad <- cor(boelstad_df,
  method = "kendall",
  use = "pairwise.complete.obs")

kendall_matrix_Spillhaug <- cor(spillhaug_df,
                               method = "kendall",
                               use = "pairwise.complete.obs")

#Melt matrix (make it longer for plotting)
kendall_corr_result_B <- reshape2::melt(
  kendall_matrix_Boelstad,
  varnames = c("Var1", "Var2"),
  value.name = "tau")

kendall_corr_result_S <- reshape2::melt(
  kendall_matrix_Spillhaug,
  varnames = c("Var1", "Var2"),
  value.name = "tau")

#Remove self correlation
kendall_corr_result_B <- kendall_corr_result_B %>%
  filter(as.character(Var1) < as.character(Var2))

kendall_corr_result_S <- kendall_corr_result_S %>%
  filter(as.character(Var1) < as.character(Var2))


#Plot a combination diagram of scattered data, to make an overview.
heat_panel <- function(data, mapping, ...) {
  
  x <- GGally::eval_data_col(data, mapping$x)
  y <- GGally::eval_data_col(data, mapping$y)
  
  keep <- complete.cases(x, y)
  
  if(sum(keep) < 3){
    return(ggplot() + theme_void())
  }
  
  kt <- cor.test(
    x[keep],
    y[keep],
    method = "kendall",
    exact = FALSE
  )
  
  tau <- round(unname(kt$estimate), 2)
  pval <- kt$p.value
  
  stars <- dplyr::case_when(
    kt$p.value < 0.001 ~ "***",
    kt$p.value < 0.01  ~ "**",
    kt$p.value < 0.05  ~ "*",
    TRUE ~ ""
  )
  
  ggplot(data.frame(x = 1, y = 1)) +
    geom_tile(aes(x, y, fill = tau)) +
    geom_text(
      aes(
        x = 1,
        y = 1,
        label = paste0(tau, stars)
      )
    ) +
    scale_fill_gradient2(
      low = "blue",
      mid = "white",
      high = "red",
      midpoint = 0,
      limits = c(-1, 1)
    ) +
    theme_void() +
    guides(fill = "none")
}

GGally::ggpairs(
  boelstad_df,
  upper = list(continuous = heat_panel),
  lower = list(continuous = GGally::wrap("points", alpha = 0.5)),
  diag  = list(continuous = GGally::wrap("densityDiag"))
)

GGally::ggpairs(
  spillhaug_df,
  upper = list(continuous = heat_panel),
  lower = list(continuous = GGally::wrap("points", alpha = 0.5)),
  diag  = list(continuous = GGally::wrap("densityDiag"))
)



#----------------CIRCLE PLOT---------------

#Boelstad
kendall_matrix_Boelstad <- cor(
  boelstad_df,
  method = "kendall",
  use = "pairwise.complete.obs"
)

# P-value matrix
p_matrix_Boelstad <- matrix(
  NA,
  nrow = ncol(boelstad_df),
  ncol = ncol(boelstad_df),
  dimnames = list(
    names(boelstad_df),
    names(boelstad_df)
  )
)

for(i in seq_len(ncol(boelstad_df))){
  
  for(j in seq_len(ncol(boelstad_df))){
    
    x <- boelstad_df[[i]]
    y <- boelstad_df[[j]]
    
    keep <- complete.cases(x, y)
    
    if(sum(keep) >= 3){
      
      p_matrix_Boelstad[i, j] <- tryCatch(
        
        cor.test(
          x[keep],
          y[keep],
          method = "kendall",
          exact = FALSE
        )$p.value,
        
        error = function(e) NA)
    }
  }}

corrplot(
  kendall_matrix_Boelstad,
  method = "circle",
  type = "upper",
  p.mat = p_matrix_Boelstad,
  sig.level = 0.05,
  insig = "blank",
  tl.col = "black",
  tl.srt = 45,
  col = colorRampPalette(
    c("blue", "white", "darkorange")
  )(200)
)

