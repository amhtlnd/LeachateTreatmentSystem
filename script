#Create a common chord diagram to display common correlations in both locations.
corr <- kendall_matrix_Boelstad

corr[
  p_matrix_Boelstad > 0.05 |
    p_matrix_Spillhaug > 0.05 |
    abs(kendall_matrix_Boelstad) < 0.3 |
    abs(kendall_matrix_Spillhaug) < 0.3
] <- 0

# Krev samme fortegn i begge lokaliteter
corr[
  sign(kendall_matrix_Boelstad) !=
    sign(kendall_matrix_Spillhaug)
] <- 0

diag(corr) <- 0

# Unngå dobbeltregistrering
corr[lower.tri(corr)] <- 0

# Fjern sektorer uten koblinger
keep <- rowSums(abs(corr)) > 0 |
  colSums(abs(corr)) > 0

corr <- corr[keep, keep]

# Farger etter tau-styrke
col_fun <- circlize::colorRamp2(
  c(0.3, 0.5, 1),
  c("#D9EAF7", "#5DA5DA", "#08306B")
)

# Plot
circos.clear()

chordDiagram(
  corr,
  col = col_fun(abs(corr)),
  transparency = 0.25,
  annotationTrack = "grid",
  preAllocateTracks = 1
)

